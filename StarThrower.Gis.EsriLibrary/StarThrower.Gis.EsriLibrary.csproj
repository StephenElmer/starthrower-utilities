<Project Sdk="Microsoft.NET.Sdk">

  <!--
    StarThrower.Gis.EsriLibrary.csproj
    =================================
    Project-specific properties only. All shared properties (Authors, Copyright,
    RepositoryUrl, License, SourceLink, etc.) are inherited from Directory.Build.props.

    Properties NOT set here (inherited from Directory.Build.props):
      Authors, Company, Product, Copyright, NeutralLanguage
      PackageProjectUrl, RepositoryUrl, RepositoryType
      PackageLicenseExpression, PackageReleaseNotes
      GenerateDocumentationFile, AnalysisMode, Nullable
      IncludeSymbols, SymbolPackageFormat
      Microsoft.SourceLink.GitHub PackageReference
  -->

  <!-- =========================================================== -->
  <!-- Build configuration                                          -->
  <!-- =========================================================== -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <AssemblyName>StarThrower.Gis.EsriLibrary</AssemblyName>
    <RootNamespace>StarThrower.Gis.EsriLibrary</RootNamespace>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- =========================================================== -->
  <!-- NuGet package identity — unique per package                  -->
  <!-- =========================================================== -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>$(AssemblyName)</PackageId>

    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>

    <Description>Read and write ESRI shapefile format (.shp/.dbf) including support for points, polylines, polygons, and multipart shapes.</Description>

    <!-- Suite-level tags inherited from Directory.Build.props.     -->
    <!-- Append package-specific tags with semicolon separator.     -->
    <!-- TODO: Claude Code documentation pass                       -->
    <PackageTags>$(PackageTags);gis;esri;shapefile;shp;dbf</PackageTags>

    <!-- Per-package README embedded in the NuGet package.         -->
    <!-- TODO: Claude Code documentation pass                       -->
    <PackageReadme>README.md</PackageReadme>
  </PropertyGroup>

  <!-- =========================================================== -->
  <!-- README embedding — pairs with <PackageReadme> above         -->
  <!-- =========================================================== -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <!-- =========================================================== -->
  <!-- Icon embedding — uncomment once icon.png is available       -->
  <!-- =========================================================== -->
  <ItemGroup>
    <None Include="..\..\icon.png" Pack="true" PackagePath="\"/>
  </ItemGroup>
 
  <!-- =========================================================== -->
  <!-- NuGet dependencies                                           -->
  <!-- =========================================================== -->
  <ItemGroup>
    <!-- Add project-specific PackageReferences here               -->
    <!-- Example:                                                   -->
    <!-- <PackageReference Include="Newtonsoft.Json" Version="13.*"/> -->
  </ItemGroup>

  <!-- =========================================================== -->
  <!-- Project references                                           -->
  <!-- =========================================================== -->
  <ItemGroup>
    <ProjectReference Include="..\StarThrower.ByteUtilities\StarThrower.ByteUtilities.csproj" />
    <ProjectReference Include="..\StarThrower.Gis.GeoUtilities\StarThrower.Gis.GeoUtilities.csproj" />
    <ProjectReference Include="..\StarThrower.StringUtilities\StarThrower.StringUtilities.csproj" />
    <ProjectReference Include="..\StarThrower.XBase\StarThrower.XBase.csproj" />
  </ItemGroup>

</Project>
