<Project Sdk="Microsoft.NET.Sdk">

  <!--
    StarThrower.Gis.GeoUtilities.Test.csproj
    =======================================
    Test projects are NOT packaged — IsPackable=false suppresses NuGet
    package generation and excludes this project from IncludeSymbols,
    SymbolPackageFormat, and Microsoft.SourceLink.GitHub (all conditioned
    on IsPackable != false in Directory.Build.props).
  -->

  <!-- =========================================================== -->
  <!-- Build configuration                                          -->
  <!-- =========================================================== -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <AssemblyName>StarThrower.Gis.GeoUtilities.Test</AssemblyName>
    <RootNamespace>StarThrower.Gis.GeoUtilities.Test</RootNamespace>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- =========================================================== -->
  <!-- Test framework                                               -->
  <!-- =========================================================== -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.4.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.4.3" />
  </ItemGroup>

  <!-- =========================================================== -->
  <!-- Project under test                                           -->
  <!-- =========================================================== -->
  <ItemGroup>
    <ProjectReference Include="..\StarThrower.Gis.GeoUtilities\StarThrower.Gis.GeoUtilities.csproj" />
    <ProjectReference Include="..\StarThrower.MathUtilities\StarThrower.MathUtilities.csproj" />
    <ProjectReference Include="..\StarThrower.StringUtilities\StarThrower.StringUtilities.csproj" />
  </ItemGroup>

</Project>
