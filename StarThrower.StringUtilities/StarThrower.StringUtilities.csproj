<Project Sdk="Microsoft.NET.Sdk">

  <!--
    StarThrower.StringUtilities.csproj
    =================================
    Project-specific properties only. All shared properties (Authors, Copyright,
    RepositoryUrl, License, SourceLink, etc.) are inherited from Directory.Build.props.

    Properties NOT set here (inherited from Directory.Build.props):
      Authors, Company, Product, Copyright, NeutralLanguage
      PackageProjectUrl, RepositoryUrl, RepositoryType
      PackageLicenseExpression, PackageReleaseNotes
      GenerateDocumentationFile, AnalysisMode, Nullable
      IncludeSymbols, SymbolPackageFormat
      Microsoft.SourceLink.GitHub PackageReference
  -->

  <!-- =========================================================== -->
  <!-- Build configuration                                          -->
  <!-- =========================================================== -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <AssemblyName>StarThrower.StringUtilities</AssemblyName>
    <RootNamespace>StarThrower.StringUtilities</RootNamespace>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- =========================================================== -->
  <!-- NuGet package identity — unique per package                  -->
  <!-- =========================================================== -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>$(AssemblyName)</PackageId>

    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>

    <Description>String manipulation and analysis utilities including encoding-aware character operations with consistent cross-platform Windows-1252 behavior.</Description>

    <!-- Suite-level tags inherited from Directory.Build.props.     -->
    <!-- Append package-specific tags with semicolon separator.     -->
    <PackageTags>$(PackageTags);string;text;utilities;encoding;tokenizing;string-formatting;windows-1252</PackageTags>

    <!-- Per-package README embedded in the NuGet package.         -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- =========================================================== -->
  <!-- README embedding — pairs with <PackageReadme> above         -->
  <!-- =========================================================== -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <!-- =========================================================== -->
  <!-- Icon embedding — pairs with <PackageIcon> in Directory.Build.props -->
  <!-- =========================================================== -->
  <ItemGroup>
    <None Include="..\icon.png" Pack="true" PackagePath="\"/>
  </ItemGroup>
 
  <!-- =========================================================== -->
  <!-- NuGet dependencies                                           -->
  <!-- =========================================================== -->
  <ItemGroup>
    <!-- Add project-specific PackageReferences here               -->
    <!-- Example:                                                   -->
    <!-- <PackageReference Include="Newtonsoft.Json" Version="13.*"/> -->
  </ItemGroup>
 
  <!-- =========================================================== -->
  <!-- Project references                                           -->
  <!-- =========================================================== -->
  <ItemGroup>
    <ProjectReference Include="..\StarThrower.MathUtilities\StarThrower.MathUtilities.csproj" />
  </ItemGroup>

</Project>
