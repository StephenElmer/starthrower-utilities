<Project Sdk="Microsoft.NET.Sdk">

  <!--
    StarThrower.XBase.Test.csproj
    =======================================
    Test projects are NOT packaged — IsPackable=false suppresses NuGet
    package generation and excludes this project from IncludeSymbols,
    SymbolPackageFormat, and Microsoft.SourceLink.GitHub (all conditioned
    on IsPackable != false in Directory.Build.props).
  -->

  <!-- =========================================================== -->
  <!-- Build configuration                                          -->
  <!-- =========================================================== -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <AssemblyName>StarThrower.XBase.Test</AssemblyName>
    <RootNamespace>StarThrower.XBase.Test</RootNamespace>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- =========================================================== -->
  <!-- Test framework                                               -->
  <!-- =========================================================== -->
  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.4.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <!-- =========================================================== -->
  <!-- Project under test                                           -->
  <!-- =========================================================== -->
  <ItemGroup>
    <ProjectReference Include="..\StarThrower.FileUtilities\StarThrower.FileUtilities.csproj" />
    <ProjectReference Include="..\StarThrower.XBase\StarThrower.XBase.csproj" />
  </ItemGroup>

</Project>
