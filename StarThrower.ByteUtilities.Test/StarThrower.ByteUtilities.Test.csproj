<Project Sdk="Microsoft.NET.Sdk">

  <!--
    StarThrower.ByteUtilities.Test.csproj
    =======================================
    Test projects are NOT packaged — IsPackable=false suppresses NuGet
    package generation and excludes this project from IncludeSymbols,
    SymbolPackageFormat, and Microsoft.SourceLink.GitHub (all conditioned
    on IsPackable != false in Directory.Build.props).
  -->

  <!-- =========================================================== -->
  <!-- Build configuration                                          -->
  <!-- =========================================================== -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <AssemblyName>StarThrower.ByteUtilities.Test</AssemblyName>
    <RootNamespace>StarThrower.ByteUtilities.Test</RootNamespace>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- =========================================================== -->
  <!-- Test framework                                               -->
  <!-- =========================================================== -->
  <ItemGroup>
    <PackageReference Include="Castle.Core" Version="5.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.4.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.4.3" />
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>

  <!-- =========================================================== -->
  <!-- Project under test                                           -->
  <!-- =========================================================== -->
  <ItemGroup>
    <ProjectReference Include="..\StarThrower.ByteUtilities\StarThrower.ByteUtilities.csproj" />
  </ItemGroup>

</Project>
